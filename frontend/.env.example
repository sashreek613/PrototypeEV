VITE_API_BASE_URL=http://127.0.0.1:8001
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_or_legacy_anon_key
# Used for email verification and password-reset redirects. Must be listed in
# Supabase Auth → URL Configuration → Redirect URLs.
VITE_SITE_URL=http://localhost:5173
# Optional MapLibre style URL. When unset, Driver/Planner maps use OSM raster
# tiles (no API key). OpenFreeMap vector styles are not used by default because
# they do not paint in MapLibre 6.
# VITE_MAP_STYLE_LIGHT=
# Optional CARTO raster key to keep Voyager tiles. Never commit a real key.
# VITE_CARTO_API_KEY=
