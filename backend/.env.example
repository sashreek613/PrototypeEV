# FastAPI talks to Postgres through SQLAlchemy.
# Use the Supabase URI (Database settings → URI, then switch the driver to postgresql+psycopg).
# Example (direct, port 5432):
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Example (transaction pooler, port 6543 — recommended for the API):
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Local Docker Postgres (optional; docker-compose.yml):
DATABASE_URL=postgresql+psycopg://vidyutone:vidyutone@localhost:5432/vidyutone

SECRET_KEY=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Used only by the seed script to read data/sites.json and data/chargers.json
# DATA_DIR=C:\path\to\VidyutOne\data

# Supabase Auth — Project Settings → API
# Never put the service_role key here if this file might be copied into the frontend.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# Optional: only needed for legacy HS256 tokens (Project Settings → API → JWT Secret)
# SUPABASE_JWT_SECRET=
# Optional: publishable/anon key, used only if you later call the Auth HTTP API from FastAPI
# SUPABASE_PUBLISHABLE_KEY=

# Designated admin email (optional). FastAPI promotes this address to role=admin
# on authenticated /api/me. Do not put the admin password here or in the frontend.
# ADMIN_EMAIL=you@example.com

# OpenChargeMap — register an app at openchargemap.org → profile → My Apps
OCM_API_KEY=

# Lyzr — planner-side "Ask about these sites" assistant (Studio → API keys).
# Never computes scores itself; only answers questions about already-scored
# site data handed to it as context. See app/services/lyzr_service.py.
LYZR_API_KEY=
LYZR_AGENT_ID=
# Separate agent for the driver-side "hands-free voice assistant" fallback
# (frontend/src/components/driver/VoiceAssistantButton.tsx) -- same API key,
# different agent, so it can carry a driver-scoped system prompt.
LYZR_DRIVER_AGENT_ID=

# Direct db.<project>.supabase.co hosts are IPv6-only. On Windows without IPv6
# that causes getaddrinfo 11001 and the API never binds (frontend: "Check your connection").
# Prefer the pooler URI (port 6543) above. Optional rewrite target if a direct host is used:
# SUPABASE_POOLER_HOST=aws-0-ap-northeast-1.pooler.supabase.com

# Local demo only. Injects labeled DEMO trade-off chargers for driver comparison.
# Leave false in production.
# DEMO_FEATURES=false

# OCPP 2.0.1 CSMS. Charge points connect to ws://<host>/api/ocpp/{charge_point_id}
# Never put OCPP_AUTH_KEY in the React app. Leave empty only for local development.
OCPP_AUTH_KEY=
OCPP_PATH_PREFIX=/api/ocpp
