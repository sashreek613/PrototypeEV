# FastAPI talks to Postgres through SQLAlchemy.
# Use the Supabase URI (Database settings → URI, then switch the driver to postgresql+psycopg).
# Example (direct, port 5432):
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Example (transaction pooler, port 6543 — recommended for the API):
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Local Docker Postgres (optional; docker-compose.yml):
DATABASE_URL=postgresql+psycopg://vidyutone:vidyutone@localhost:5432/vidyutone

SECRET_KEY=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Used only by the seed script to read data/sites.json and data/chargers.json
# DATA_DIR=C:\path\to\VidyutOne\data
